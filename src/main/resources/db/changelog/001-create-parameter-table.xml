<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1" author="deniz">

        <!-- 1. Ülke Tablosu -->
        <createTable tableName="country">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 2. Şehir Tablosu -->
        <createTable tableName="city">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="country_id" type="BIGINT">
                <!-- Şehir tablosundaki country_id, ülke tablosundaki id'ye referans verir -->
                <constraints nullable="false" foreignKeyName="fk_city_country" referencedTableName="country" referencedColumnNames="id"/>
            </column>
        </createTable>

        <!-- 3. İlçe Tablosu -->
        <createTable tableName="district">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_district_city" referencedTableName="city" referencedColumnNames="id"/>
            </column>
        </createTable>


    </changeSet>

</databaseChangeLog>